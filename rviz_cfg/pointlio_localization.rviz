Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /TF1/Frames1
    - /Camera1
    Splitter Ratio: 0.5
  Tree Height: 257
  SyncSource: Prior map
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
  SyncSource: Prior map
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: Prior map
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: Prior map
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.4000000059604645
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 80; 80; 80
    Enabled: true
    Line Style:
